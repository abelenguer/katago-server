# Bundled by Dockerfile.katago-cuda; runtime environment variables override it.
[server]
host = "0.0.0.0"
port = 2718                      # KATAGO_SERVER_PORT, otherwise platform PORT
request_timeout_secs = 300
max_concurrent_requests = 8
max_body_bytes = 1048576
cors_allowed_origins = ["*"]
log_format = "json"

[katago]
katago_path = "/usr/local/bin/katago"
model_path = "/app/model.bin.gz"
config_path = "/app/analysis_config.cfg"
move_timeout_secs = 60
default_max_visits = 50
max_visits_limit = 2000
max_restart_attempts = 10
